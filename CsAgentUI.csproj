<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <DebugType>none</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <!--
      The web UI serves all assets (HTML/JS/CSS) from embedded resources, so the
      ASP.NET static web assets feature is unused. Disable it to prevent the
      staticwebassets.endpoints.json from being generated and published as dead
      weight in the single-file output.
    -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!--
      The project intentionally uses System.Text.Json.Nodes with AOT/trimming.
      The IL2026/IL3050 warnings are informational about AOT compatibility and
      are accepted as part of this design, so they are suppressed to keep the
      build warning-free.
    -->
    <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <!--
    The PhotinoAOT/ directory is a reference implementation (cloned for study).
    It is NOT part of this project and must be excluded from compilation,
    otherwise its .cs files and generated obj/ artifacts leak into this build.
  -->
  <ItemGroup>
    <Compile Remove="PhotinoAOT\**\*.cs" />
    <EmbeddedResource Remove="PhotinoAOT\**\*" />
    <None Remove="PhotinoAOT\**\*" />
    <Content Remove="PhotinoAOT\**\*" />
  </ItemGroup>

  <!--
    The wwwroot/ directory is unused by the app (all web assets are embedded
    resources). Exclude it from the build and publish output so it doesn't get
    copied as dead weight alongside the single-file executable.
  -->
  <ItemGroup>
    <Content Remove="wwwroot\**\*" />
    <None Remove="wwwroot\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="3.2.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web UI assets (ASP.NET/SSE mode) -->
    <EmbeddedResource Include="src\Presentation\Web\assets\index.html" />
    <EmbeddedResource Include="src\Presentation\Web\assets\app.js" />
    <EmbeddedResource Include="src\Presentation\Web\assets\styles.css" />
    <!-- Desktop UI assets (Photino mode) -->
    <EmbeddedResource Include="src\Presentation\Desktop\assets\index.html" />
    <EmbeddedResource Include="src\Presentation\Desktop\assets\app.js" />
    <EmbeddedResource Include="src\Presentation\Desktop\assets\styles.css" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="download\" />
  </ItemGroup>

</Project>
